{
  "$id": "https://genesis.js/update_payee_account",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payee_unique_id",
    "account_unique_id",
    "account"
  ],
  "properties": {
    "payee_unique_id": {
      "$ref": "/definitions/definitions#payee_unique_id"
    },
    "account_unique_id": {
      "type": "string",
      "description": "The unique identifier of the Account"
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country"
      ],
      "properties": {
        "country": {
          "$ref": "/definitions/country",
          "description": "Country code in ISO 3166. If not provided, it will be assumed that the account country is the same as the country of the payee to which it belongs."
        }
      }
    }
  }
}
