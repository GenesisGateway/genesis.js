{
  "$id": "https://genesis.js/webmoney",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_type",
    "transaction_id",
    "remote_ip",
    "return_success_url",
    "return_failure_url",
    "amount",
    "currency",
    "customer_email",
    "billing_address"
  ],
  "allOf": [
    {
      "$ref": "/definitions/definitions#minimum"
    },
    {
      "$ref": "/definitions/definitions#common"
    },
    {
      "$ref": "/definitions/attributes/financial/payment"
    }
  ],
  "properties": {
    "transaction_type": {
      "allOf": [
        {
          "$ref": "/definitions/definitions#transaction_type"
        },
        {
          "const": "webmoney"
        }
      ]
    },
    "transaction_id": {},
    "usage": {},
    "remote_ip": {},
    "return_success_url": {
      "$ref": "/definitions/definitions#url"
    },
    "return_failure_url": {
      "$ref": "/definitions/definitions#url"
    },
    "amount": {},
    "currency": {},
    "is_payout": {},
    "customer_account_id": {
        "type": "string",
        "maxLength": 12
    },
    "customer_email": {},
    "customer_phone": {},
    "billing_address": {
      "allOf": [
        {
          "$ref": "/definitions/attributes/customer/address#billing"
        },
        {
          "required": ["country"]
        }
      ]
    },
    "shipping_address": {
      "$ref": "/definitions/attributes/customer/address#shipping"
    },
    "use_smart_router": {
      "$ref": "/definitions/definitions#use_smart_router"
    }
  }
}

