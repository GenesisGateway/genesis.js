{
  "$id": "https://genesis.js/neteller",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_type",
    "transaction_id",
    "remote_ip",
    "return_success_url",
    "return_failure_url",
    "amount",
    "currency",
    "customer_email",
    "customer_account",
    "account_password",
    "billing_address"
  ],
  "allOf": [
    {
      "$ref": "/definitions/definitions#minimum"
    },
    {
      "$ref": "/definitions/definitions#common"
    },
    {
      "$ref": "/definitions/attributes/financial/payment"
    }
  ],
  "properties": {
    "transaction_type": {
      "allOf": [
        {
          "$ref": "/definitions/definitions#transaction_type"
        },
        {
          "const": "neteller"
        }
      ]
    },
    "transaction_id": {},
    "usage": {},
    "remote_ip": {},
    "return_success_url": {
      "$ref": "/definitions/definitions#url"
    },
    "return_failure_url": {
      "$ref": "/definitions/definitions#url"
    },
    "amount": {},
    "currency": {},
    "customer_email": {},
    "customer_phone": {},
    "customer_account": {
      "type": "string",
      "maxLength": 100
    },
    "account_password": {
      "type": "string",
      "maxLength": 6
    },
    "billing_address": {
      "allOf": [
        {
          "$ref": "/definitions/attributes/customer/address#billing"
        },
        {
          "required": ["country"]
        }
      ]
    },
    "shipping_address": {
      "$ref": "/definitions/attributes/customer/address#shipping"
    },
    "use_smart_router": {
      "$ref": "/definitions/definitions#use_smart_router"
    }
  }
}
