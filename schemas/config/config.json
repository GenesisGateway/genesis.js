{
  "$id": "https://genesis.js/config",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "customer",
    "gateway"
  ],
  "properties": {
    "customer": {
      "type": "object",
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string"
        },
        "billing_api_token": {
          "type": "string"
        },
        "force_smart_routing": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "$ref": "/definitions/config/gateway"
    },
    "notifications": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
